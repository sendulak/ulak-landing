---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="pricing — ulak" description="simple pricing for personalized email campaigns. start free, scale when you're ready.">
  <Nav />
  <main class="pt-28 pb-20 md:pt-36 md:pb-28">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center hero-enter">
        <h1 class="text-5xl md:text-6xl font-extrabold tracking-tight">Pricing</h1>
        <p class="mt-4 text-lg text-gray-500 max-w-[44ch] mx-auto">
          Start free. Upgrade when your list grows.
        </p>
      </div>

      <div class="mt-16 grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        <!-- Free -->
        <div class="border border-gray-200 rounded-2xl p-8 flex flex-col fade-in stagger-1">
          <p class="text-sm font-semibold text-gray-400 uppercase tracking-wider">Free</p>
          <p class="mt-3 text-4xl font-extrabold tracking-tight">$0<span class="text-base font-medium text-gray-400">/mo</span></p>
          <ul class="mt-8 space-y-3 text-sm text-gray-600 flex-1">
            <li class="flex gap-2"><span class="text-gray-400">&#10003;</span>Up to 1,000 people</li>
            <li class="flex gap-2"><span class="text-gray-400">&#10003;</span>5,000 emails/month</li>
            <li class="flex gap-2"><span class="text-gray-400">&#10003;</span>AI campaign generation</li>
            <li class="flex gap-2"><span class="text-gray-400">&#10003;</span>AI personalization</li>
            <li class="flex gap-2"><span class="text-gray-400">&#10003;</span>Basic analytics</li>
            <li class="flex gap-2"><span class="text-gray-400">&#10003;</span>ulak branding</li>
          </ul>
          <a href="#get-started" class="mt-8 block text-center border border-gray-900 text-gray-900 font-medium py-3 rounded-lg hover:bg-gray-50 transition-colors">
            Start free
          </a>
        </div>

        <!-- Pro (recommended) -->
        <div class="border-2 border-gray-900 rounded-2xl p-8 flex flex-col relative fade-in stagger-2">
          <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-gray-900 text-white text-xs font-semibold px-3 py-1 rounded-full">Recommended</span>
          <p class="text-sm font-semibold text-gray-400 uppercase tracking-wider">Pro</p>
          <p class="mt-3 text-4xl font-extrabold tracking-tight">$79<span class="text-base font-medium text-gray-400">/mo</span></p>
          <ul class="mt-8 space-y-3 text-sm text-gray-600 flex-1">
            <li class="flex gap-2"><span class="text-gray-900">&#10003;</span>Up to 10,000 people</li>
            <li class="flex gap-2"><span class="text-gray-900">&#10003;</span>100,000 emails/month</li>
            <li class="flex gap-2"><span class="text-gray-900">&#10003;</span>Unlimited campaigns</li>
            <li class="flex gap-2"><span class="text-gray-900">&#10003;</span>Advanced AI personalization</li>
            <li class="flex gap-2"><span class="text-gray-900">&#10003;</span>Brand voice training</li>
            <li class="flex gap-2"><span class="text-gray-900">&#10003;</span>A/B testing</li>
            <li class="flex gap-2"><span class="text-gray-900">&#10003;</span>Remove ulak branding</li>
          </ul>
          <a href="#get-started" class="mt-8 block text-center bg-gray-900 text-white font-medium py-3 rounded-lg hover:bg-gray-800 transition-colors">
            Start growing
          </a>
        </div>

        <!-- Scale -->
        <div class="border border-gray-200 rounded-2xl p-8 flex flex-col fade-in stagger-3">
          <p class="text-sm font-semibold text-gray-400 uppercase tracking-wider">Scale</p>
          <p class="mt-3 text-4xl font-extrabold tracking-tight">$299<span class="text-base font-medium text-gray-400">/mo</span></p>
          <ul class="mt-8 space-y-3 text-sm text-gray-600 flex-1">
            <li class="flex gap-2"><span class="text-gray-400">&#10003;</span>Up to 50,000 people</li>
            <li class="flex gap-2"><span class="text-gray-400">&#10003;</span>500,000 emails/month</li>
            <li class="flex gap-2"><span class="text-gray-400">&#10003;</span>Team access</li>
            <li class="flex gap-2"><span class="text-gray-400">&#10003;</span>Advanced segmentation</li>
            <li class="flex gap-2"><span class="text-gray-400">&#10003;</span>API access</li>
            <li class="flex gap-2"><span class="text-gray-400">&#10003;</span>Priority support</li>
          </ul>
          <a href="#get-started" class="mt-8 block text-center border border-gray-900 text-gray-900 font-medium py-3 rounded-lg hover:bg-gray-50 transition-colors">
            Scale your outreach
          </a>
        </div>

        <!-- Enterprise -->
        <div class="border border-gray-200 rounded-2xl p-8 flex flex-col fade-in stagger-4">
          <p class="text-sm font-semibold text-gray-400 uppercase tracking-wider">Enterprise</p>
          <p class="mt-3 text-4xl font-extrabold tracking-tight">Custom</p>
          <ul class="mt-8 space-y-3 text-sm text-gray-600 flex-1">
            <li class="flex gap-2"><span class="text-gray-400">&#10003;</span>Unlimited audience</li>
            <li class="flex gap-2"><span class="text-gray-400">&#10003;</span>Dedicated infrastructure</li>
            <li class="flex gap-2"><span class="text-gray-400">&#10003;</span>SSO</li>
            <li class="flex gap-2"><span class="text-gray-400">&#10003;</span>SLA</li>
            <li class="flex gap-2"><span class="text-gray-400">&#10003;</span>Custom integrations</li>
          </ul>
          <a href="#contact" class="mt-8 block text-center border border-gray-900 text-gray-900 font-medium py-3 rounded-lg hover:bg-gray-50 transition-colors">
            Talk to sales
          </a>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
