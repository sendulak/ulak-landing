---
---

<section id="product" class="py-20 md:py-28 bg-gray-50">
  <div class="max-w-5xl mx-auto px-6 text-center">
    <h2 class="text-4xl md:text-5xl font-bold tracking-tight fade-in">
      Your customers can tell it's a blast.
    </h2>

    <!-- Split screen visual -->
    <div class="mt-16 grid md:grid-cols-2 gap-8 max-w-3xl mx-auto">
      <!-- Traditional -->
      <div class="text-left fade-in-left">
        <p class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-4">Everyone gets this</p>
        <div class="space-y-3">
          {[1, 2, 3, 4].map(() => (
            <div class="border border-gray-200 bg-white rounded-lg p-4">
              <div class="h-2 w-3/4 bg-gray-200 rounded mb-2"></div>
              <div class="h-2 w-full bg-gray-100 rounded mb-1"></div>
              <div class="h-2 w-5/6 bg-gray-100 rounded mb-1"></div>
              <div class="h-2 w-full bg-gray-100 rounded"></div>
            </div>
          ))}
        </div>
        <p class="mt-3 text-xs text-gray-400 text-center">Copy-paste. Ignore. Delete.</p>
      </div>

      <!-- ulak -->
      <div class="text-left fade-in-right">
        <p class="text-sm font-semibold text-gray-900 uppercase tracking-wider mb-4">with ulak</p>
        <div class="space-y-3">
          <!-- Email A: has image preview + longer content -->
          <div class="border border-gray-900 bg-white rounded-lg p-4">
            <div class="h-2 w-2/3 bg-gray-900 rounded mb-3"></div>
            <div class="h-14 w-full bg-gray-100 rounded mb-3 flex items-center justify-center overflow-hidden">
              <svg viewBox="0 0 120 40" class="w-20 h-8 text-gray-300" fill="none" stroke="currentColor" stroke-width="1">
                <rect x="2" y="2" width="36" height="36" rx="4" />
                <circle cx="14" cy="16" r="5" />
                <path d="M2 30 L14 20 L26 28 L32 24 L38 30" />
              </svg>
            </div>
            <div class="h-2 w-full bg-gray-200 rounded mb-1"></div>
            <div class="h-2 w-4/5 bg-gray-200 rounded mb-1"></div>
            <div class="h-2 w-full bg-gray-200 rounded"></div>
          </div>
          <!-- Email B: short, text only -->
          <div class="border border-gray-900 bg-white rounded-lg p-4">
            <div class="h-2 w-1/2 bg-gray-900 rounded mb-3"></div>
            <div class="h-2 w-5/6 bg-gray-200 rounded mb-1"></div>
            <div class="h-2 w-2/3 bg-gray-200 rounded"></div>
          </div>
          <!-- Email C: has image preview + medium content -->
          <div class="border border-gray-900 bg-white rounded-lg p-4">
            <div class="h-2 w-3/5 bg-gray-900 rounded mb-3"></div>
            <div class="h-10 w-full bg-gray-100 rounded mb-3 flex items-center justify-center overflow-hidden">
              <svg viewBox="0 0 120 32" class="w-16 h-6 text-gray-300" fill="none" stroke="currentColor" stroke-width="1">
                <rect x="2" y="2" width="28" height="28" rx="4" />
                <path d="M8 22 L14 14 L20 18 L26 10" />
                <circle cx="10" cy="10" r="3" />
              </svg>
            </div>
            <div class="h-2 w-full bg-gray-200 rounded mb-1"></div>
            <div class="h-2 w-3/4 bg-gray-200 rounded"></div>
          </div>
          <!-- Email D: shortest, just a CTA feel -->
          <div class="border border-gray-900 bg-white rounded-lg p-4">
            <div class="h-2 w-2/5 bg-gray-900 rounded mb-3"></div>
            <div class="h-2 w-full bg-gray-200 rounded mb-1"></div>
            <div class="h-2 w-1/2 bg-gray-200 rounded mb-3"></div>
            <div class="h-5 w-20 bg-gray-900 rounded"></div>
          </div>
        </div>
        <p class="mt-3 text-xs text-gray-900 text-center font-medium">Every single one is different.</p>
      </div>
    </div>

    <p class="mt-12 text-lg text-gray-500 max-w-[50ch] mx-auto leading-relaxed fade-in">
      People skip emails that weren't meant for them. ulak rewrites each one using what you already know about your audience.
    </p>
  </div>
</section>
