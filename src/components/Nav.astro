---
---

<nav aria-label="Main navigation" class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-md border-b border-gray-100">
  <div class="max-w-6xl mx-auto px-6 h-14 flex items-center justify-between">
    <a href="/" class="text-lg font-bold tracking-tight">ulak</a>
    <div class="hidden md:flex items-center gap-8 text-sm text-muted">
      <a href="/#product" class="hover:text-ink transition-colors">Product</a>
      <a href="/pricing" class="hover:text-ink transition-colors">Pricing</a>
      <a href="/docs" class="hover:text-ink transition-colors">Docs</a>
    </div>
    <div class="flex items-center gap-3">
      <a href="https://app.sendulak.com" class="text-sm text-muted hover:text-ink transition-colors hidden sm:block">Login</a>
      <a href="https://app.sendulak.com" class="text-sm font-medium bg-primary text-white px-4 py-2 rounded-lg hover:bg-primary-hover transition-colors">Get Started</a>
      <button
        id="nav-toggle"
        class="md:hidden p-2 -mr-2 text-ink"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path id="nav-icon" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>
  <div id="nav-menu" class="hidden md:hidden border-t border-gray-100 bg-white/95 backdrop-blur-md">
    <div class="max-w-6xl mx-auto px-6 py-3 flex flex-col gap-1 text-sm">
      <a href="/#product" class="py-2 text-muted hover:text-ink transition-colors">Product</a>
      <a href="/pricing" class="py-2 text-muted hover:text-ink transition-colors">Pricing</a>
      <a href="/docs" class="py-2 text-muted hover:text-ink transition-colors">Docs</a>
      <a href="https://app.sendulak.com" class="py-2 text-muted hover:text-ink transition-colors sm:hidden">Login</a>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');
  const icon = document.getElementById('nav-icon');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    if (icon) {
      icon.setAttribute('d', isOpen ? 'M6 6l12 12M6 18L18 6' : 'M4 6h16M4 12h16M4 18h16');
    }
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      if (icon) icon.setAttribute('d', 'M4 6h16M4 12h16M4 18h16');
    });
  });
</script>
