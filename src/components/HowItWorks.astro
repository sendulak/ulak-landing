---
---

<section id="how-it-works" class="py-20 md:py-28">
  <div class="max-w-5xl mx-auto px-6">
    <h2 class="text-4xl md:text-5xl font-bold tracking-tight text-center fade-in">
      Three steps, that's it
    </h2>

    <div class="mt-16 grid md:grid-cols-3 gap-12">
      <!-- Step 1 -->
      <div class="text-center fade-in stagger-1">
        <div class="flex justify-center mb-6">
          <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" class="w-16 h-16 text-gray-900" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="12" y="16" width="40" height="32" rx="4" />
            <line x1="12" y1="28" x2="52" y2="28" />
            <line x1="12" y1="36" x2="52" y2="36" />
            <line x1="28" y1="16" x2="28" y2="48" />
            <circle cx="20" cy="22" r="2" />
            <circle cx="36" cy="22" r="2" />
          </svg>
        </div>
        <p class="text-sm font-semibold text-gray-400 mb-2">1</p>
        <h3 class="text-xl font-bold mb-3">Bring your contacts</h3>
        <p class="text-gray-500 leading-relaxed">
          Pull them in from Stripe, HubSpot, Salesforce, or just upload a CSV.
        </p>
      </div>

      <!-- Step 2 -->
      <div class="text-center fade-in stagger-2">
        <div class="flex justify-center mb-6">
          <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" class="w-16 h-16 text-gray-900" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="8" y="12" width="48" height="40" rx="4" />
            <line x1="16" y1="24" x2="36" y2="24" />
            <line x1="16" y1="32" x2="48" y2="32" />
            <line x1="16" y1="40" x2="28" y2="40" />
            <rect x="38" y="38" width="10" height="6" rx="1" />
            <path d="M16 24 L14 24" stroke-width="2" />
          </svg>
        </div>
        <p class="text-sm font-semibold text-gray-400 mb-2">2</p>
        <h3 class="text-xl font-bold mb-3">Say what you want to send</h3>
        <p class="text-gray-500 leading-relaxed">
          Describe your campaign in plain language. A sentence is enough.
        </p>
      </div>

      <!-- Step 3 -->
      <div class="text-center fade-in stagger-3">
        <div class="flex justify-center mb-6">
          <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" class="w-16 h-16 text-gray-900" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="16" cy="32" r="6" />
            <path d="M22 32 L32 20" />
            <path d="M22 32 L32 32" />
            <path d="M22 32 L32 44" />
            <rect x="34" y="14" width="18" height="12" rx="2" />
            <path d="M34 14 L43 21 L52 14" />
            <rect x="34" y="26" width="18" height="12" rx="2" />
            <path d="M34 26 L43 33 L52 26" />
            <rect x="34" y="38" width="18" height="12" rx="2" />
            <path d="M34 38 L43 45 L52 38" />
          </svg>
        </div>
        <p class="text-sm font-semibold text-gray-400 mb-2">3</p>
        <h3 class="text-xl font-bold mb-3">Hit send</h3>
        <p class="text-gray-500 leading-relaxed">
          ulak writes a unique version for every person. You review, then send.
        </p>
      </div>
    </div>
  </div>
</section>
