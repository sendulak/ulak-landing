---
---

<section class="pt-28 pb-20 md:pt-36 md:pb-28">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid md:grid-cols-[5fr_7fr] gap-10 md:gap-12 items-center">
      <!-- Left: Copy -->
      <div class="max-w-lg hero-enter">
        <h1 class="text-6xl md:text-7xl lg:text-[88px] font-extrabold leading-[0.95] tracking-tight">
          One campaign.<br />
          <span class="text-gray-400">Thousands of unique emails.</span>
        </h1>
        <p class="mt-6 text-lg text-gray-500 leading-relaxed max-w-[42ch]">
          ulak writes a different email for every person on your list. Same campaign, but each one reads like you wrote it yourself.
        </p>
        <div class="mt-8 flex items-center gap-4">
          <a href="#get-started" class="inline-flex items-center gap-2 bg-gray-900 text-white px-6 py-3 rounded-lg font-medium hover:bg-gray-800 transition-colors">
            Start sending <span aria-hidden="true">&rarr;</span>
          </a>
          <a href="#demo" class="text-gray-600 hover:text-gray-900 font-medium px-4 py-3 transition-colors">
            Book a demo
          </a>
        </div>
        <p class="mt-10 text-sm text-gray-400">
          Works with your existing data. Takes minutes to set up.
        </p>
      </div>

      <!-- Right: Hero Illustration -->
      <div class="flex justify-center md:justify-end hero-enter-image">
        <picture>
          <source srcset="/hero-messenger.webp" type="image/webp" />
          <img
            src="/hero-messenger.png"
            alt="An ulak messenger on horseback scattering hundreds of personalized letters into the wind"
            width="800"
            height="533"
            class="w-full"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
      </div>
    </div>
  </div>
</section>
