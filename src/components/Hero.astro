---
---

<section class="pt-28 pb-20 md:pt-36 md:pb-28">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid md:grid-cols-[5fr_7fr] gap-10 md:gap-12 items-center">
      <div class="max-w-lg hero-enter">
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-extrabold leading-[0.95] tracking-tight text-balance">
          One campaign.<br />
          <span class="text-muted">Thousands of unique emails.</span>
        </h1>
        <p class="mt-6 text-lg text-muted leading-relaxed max-w-[42ch]">
          ulak writes a different email for every person on your list. Same campaign, but each one reads like you wrote it yourself.
        </p>
        <div class="mt-8 flex items-center gap-4">
          <a href="https://app.sendulak.com" class="inline-flex items-center gap-2 bg-primary text-white px-6 py-3 rounded-lg font-medium hover:bg-primary-hover transition-colors">
            Start sending <span aria-hidden="true">&rarr;</span>
          </a>
          <a href="mailto:hello@sendulak.com?subject=Demo%20request" class="text-muted hover:text-ink font-medium px-4 py-3 transition-colors">
            Book a demo
          </a>
        </div>
        <p class="mt-10 text-sm text-muted">
          Connects to Stripe, HubSpot, Salesforce, or any CSV.
        </p>
      </div>

      <div class="flex justify-center md:justify-end hero-enter-image">
        <img
          src="/hero-messenger.png"
          alt="An ulak messenger on horseback scattering hundreds of personalized letters into the wind"
          width="800"
          height="533"
          class="w-full"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>
